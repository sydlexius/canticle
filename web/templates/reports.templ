package templates

// The Reports workspace (#211): a true two-pane, run-on-demand surface over the
// five canned read-only reports from the #186 design of record. The reports are
// nested under the REPORTS group in the left sidebar (see sidebar.templ); this
// file owns only the right-hand content pane. Selecting a report from the
// sidebar (or pressing "Refresh") fires an htmx GET that runs the query and swaps
// the pane into the main content area. There is no polling, SSE, or auto-refresh
// anywhere -- every execution is user-initiated.
//
// Degradation without JS: each sidebar report row and the "Refresh" control is a
// real anchor whose href equals its hx-get URL, so without htmx a click navigates
// to /reports/{key}, which the handler renders as a full page (shell + selected
// report) instead of a bare fragment.

// ReportsPage renders the workspace shell: the sidebar (with the report nav) plus
// the full-width content pane. view is nil on the default landing (no report
// selected, the placeholder pane shows); when a report is selected via a non-htmx
// navigation the handler passes the rendered ReportView so the full page lands on
// that report. reports is the sidebar report-nav model.
templ ReportsPage(version string, reports []RailItem, view *ReportView, musixmatchInactive bool, musixmatchServing bool) {
	@Layout("Reports", "/reports", version, reports, "", musixmatchInactive, musixmatchServing) {
		@reportPane(view)
	}
}

// ReportFragment is the htmx response for a report run: the content pane (swapped
// into #mx-main via innerHTML) plus an out-of-band re-render of the sidebar report
// nav so the selected report highlights in place.
templ ReportFragment(reports []RailItem, view ReportView) {
	@reportPane(&view)
	@reportNav(reports, true)
}

// reportPane is the full-width content pane: the selected report (header + table)
// or, when none is selected, the placeholder. Its id is retained for structure;
// the htmx swap target is the enclosing #mx-main so a selection from any page
// (including /config, which has no pane) lands consistently.
templ reportPane(view *ReportView) {
	<div class="mx-report-pane" id="mx-report-pane">
		if view != nil {
			@reportView(*view)
		} else {
			@reportPlaceholder()
		}
	</div>
}

// reportPlaceholder is the content-pane default before any report is selected.
templ reportPlaceholder() {
	<div class="mx-report-empty">
		<span>Select a report from the left to run it. Reports execute on demand; nothing runs until you choose one.</span>
	</div>
}

// reportView renders the right-pane header (title, last-run, Refresh) and the
// report's results table, dispatched by Key.
templ reportView(v ReportView) {
	@MarkStatusLine(v.Status)
	<div class="mx-report-head">
		<div>
			<h2 class="mx-report-title">{ v.Title }</h2>
			<p class="mx-report-sub">{ v.Subtitle }</p>
		</div>
		<div class="mx-report-actions">
			<span class="mx-report-ts">
				if v.LastRun != "" {
					Last run: { v.LastRun }
				} else {
					Not run yet
				}
			</span>
			<a
				class="mx-run-button"
				href={ templ.SafeURL(refreshHref(v)) }
				hx-get={ refreshHref(v) }
				hx-target="#mx-main"
				hx-swap="innerHTML"
			>
				Refresh
			</a>
		</div>
	</div>
	switch v.Key {
		case "recent-outcomes":
			@tableRecentOutcomes(v.Columns, v.RecentRows)
		case "needs-attention":
			@attentionTable(v.AttentionRows, "Nothing failed or deferred.")
		case "provider-effectiveness":
			@tableProviders(v.ProviderRows)
		case "instrumental-inventory":
			@tableInstrumentals(v.Columns, v.InstrumentalRows)
		case "failure-analysis":
			@tableFailures(v.FailureRows, "No failed tracks.")
		case "deferred-misses":
			@tableFailures(v.FailureRows, "No deferred misses.")
		case "review-queue":
			@tableReviewQueue(v.Columns, v.ReviewQueueRows, v.ReviewQueueWrongTimingHref)
	}
}

// reportEmpty renders a clean empty state for a report that returned zero rows,
// so an empty result reads as "nothing to show" rather than a broken table.
templ reportEmpty(msg string) {
	<div class="mx-report-empty"><span>{ msg }</span></div>
}

// tableRecentOutcomes renders the Recent outcomes table under its sortable header row.
templ tableRecentOutcomes(cols []SortHeaderView, rows []RecentOutcomeRow) {
	if len(rows) == 0 {
		@reportEmpty("No completed tracks yet.")
	} else {
		<div class="mx-table-wrap">
			<table class="mx-table">
				<thead>
					<tr>
						for _, col := range cols {
							@SortHeader(col)
						}
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td>{ r.Artist }</td>
							<td>{ AlbumText(r.Album) }</td>
							<td>{ r.Title }</td>
							<td class="mx-cell-mono">
								if r.ResultTierClass != "" {
									<span class={ r.ResultTierClass } if r.ResultAria != "" { role="img" aria-label={ r.ResultAria } }>{ r.Result }</span>
								} else {
									{ r.Result }
								}
							</td>
							<td class="mx-cell-mono">{ r.Detail }</td>
							<td class="mx-cell-mono">@laneCell(r.Lane, r.LaneMark)</td>
							<td class="mx-cell-mono">{ r.CompletedAt }</td>
							<td class="mx-row-hit-td">
								@RowActionsCellWrap() {
									@RowActionsCell(r.Actions)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ tableProviders(rows []ProviderRow) {
	if len(rows) == 0 {
		@reportEmpty("No provider attempts recorded yet. This populates as tracks are processed.")
	} else {
		<div class="mx-table-wrap">
			<table class="mx-table">
				<thead>
					<tr>
						<th scope="col">Source</th>
						<th scope="col">Hits</th>
						<th scope="col">Misses</th>
						<th scope="col">Hit-rate</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td>@laneCell(r.Lane, r.LaneMark)</td>
							<td class="mx-cell-mono">{ r.Hits }</td>
							<td class="mx-cell-mono">{ r.Misses }</td>
							<td class="mx-cell-mono">{ r.HitRate }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// tableInstrumentals renders the instrumental inventory under its sortable header row.
templ tableInstrumentals(cols []SortHeaderView, rows []InstrumentalRow) {
	if len(rows) == 0 {
		@reportEmpty("No audio-detected instrumentals.")
	} else {
		<div class="mx-table-wrap">
			<table class="mx-table">
				<thead>
					<tr>
						for _, col := range cols {
							@SortHeader(col)
						}
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td>{ r.Artist }</td>
							<td>{ AlbumText(r.Album) }</td>
							<td>{ r.Title }</td>
							<td class="mx-cell-mono">{ r.ID }</td>
							<td class="mx-cell-mono">{ r.File }</td>
							<td class="mx-cell-mono">{ r.DetectRequested }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ tableFailures(rows []FailureRow, emptyMsg string) {
	<p class="mx-approx">
		Tracks given up on after repeated misses are listed under
		<a class="mx-text-link" href="/queue/unavailable">Unavailable</a>.
	</p>
	if len(rows) == 0 {
		@reportEmpty(emptyMsg)
	} else {
		<div class="mx-table-wrap">
			<table class="mx-table">
				<thead>
					<tr>
						<th scope="col">Status</th>
						<th scope="col">Reason</th>
						<th scope="col">Count</th>
						<th scope="col">Rows</th>
					</tr>
				</thead>
				<tbody>
					for i, r := range rows {
						<tr>
							<td class="mx-cell-mono">{ r.Status }</td>
							<td>
								{ r.Reason }
								if r.Class != "" {
									<span class={ "mx-class-badge mx-class-" + r.Class }>{ r.Class }</span>
								}
							</td>
							<td class="mx-cell-mono">{ r.Count }</td>
							<td>
								<button
									type="button"
									class="mx-run-button mx-fg-toggle"
									aria-expanded="false"
									aria-controls={ FailureDetailID(i) }
									hx-get={ FailureGroupHref(r.Status, r.Reason) }
									hx-target={ "#" + FailureDetailID(i) }
									hx-swap="innerHTML"
									hx-sync="this:drop"
								>
									Show rows
								</button>
							</td>
						</tr>
						<tr class="mx-fg-detail" hidden>
							<td colspan="4" id={ FailureDetailID(i) }></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// FailureGroupRows is the htmx fragment behind a group's "Show rows" control:
// the newest rows of one failure group, or an empty-state line for a signature
// that matches nothing.
templ FailureGroupRows(view FailureGroupView) {
	if len(view.Rows) == 0 {
		<p class="mx-dash-empty">No rows in this group.</p>
	} else {
		<div class="mx-table-wrap mx-fg-wrap">
			<table class="mx-table" aria-label="Rows in this failure group">
				<thead>
					<tr>
						for _, col := range view.Columns {
							@SortHeader(col)
						}
					</tr>
				</thead>
				<tbody>
					for _, r := range view.Rows {
						<tr>
							<td>{ r.Artist }</td>
							<td>{ AlbumText(r.Album) }</td>
							<td>{ r.Title }</td>
							<td class="mx-cell-mono">{ r.NextAttemptAt }</td>
							<td class="mx-cell-mono">{ r.MissCount }</td>
							<td class="mx-cell-mono">{ r.Attempts }</td>
							<td class="mx-cell-mono">{ r.UpdatedAt }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if view.Truncated {
			<p class="mx-approx">{ FailureTruncatedNote(len(view.Rows)) }</p>
		}
	}
}

// tableReviewQueue renders the timing review queue under its sortable header row, with a link to the wrong-timing view.
templ tableReviewQueue(cols []SortHeaderView, rows []ReviewQueueRow, wrongTimingHref string) {
	if len(rows) == 0 {
		@reportEmpty("No tracks awaiting a timing review.")
	} else {
		if wrongTimingHref != "" {
			<p class="mx-report-sub mx-report-links">
				<a class="mx-report-link" href={ templ.SafeURL(wrongTimingHref) }>View settled mis-synced tracks in the Work Queue</a>
			</p>
		}
		<div class="mx-table-wrap">
			<table class="mx-table">
				<thead>
					<tr>
						for _, col := range cols {
							@SortHeader(col)
						}
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td>{ r.Artist }</td>
							<td>{ AlbumText(r.Album) }</td>
							<td>{ r.Title }</td>
							<td class="mx-cell-mono">{ r.Outcome }</td>
							<td class="mx-cell-mono">{ r.OverrunSeconds }</td>
							<td class="mx-cell-mono">{ r.Ratio }</td>
							<td class="mx-cell-mono">{ r.EvaluatedAt }</td>
							<td>
								if r.PreviewHref != "" {
									<a class="mx-report-link" href={ templ.SafeURL(r.PreviewHref) }>Preview</a>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
