package templates

// The observability dashboard (#186): a read-only status surface for serve
// mode. Three sections: work-queue stat tiles, a Results row, per-provider
// hit tiles, and a recent-outcomes table. A small footer note documents /metrics.
//
// Async/queued copy throughout: the dashboard makes the background processing
// model explicit so an operator does not expect on-demand search results.
// There is no search box, no manual source selection, and no auto-refresh
// (every render is triggered by a page load or explicit browser refresh).

// DashboardPage is the full-page dashboard shell.
templ DashboardPage(version string, reports []RailItem, view DashboardView, musixmatchInactive bool, musixmatchServing bool) {
	@Layout("Dashboard", "/dashboard", version, reports, "/static/css/dashboard.css", musixmatchInactive, musixmatchServing) {
		@dashboardContent(view)
	}
}

// dashboardContent is the main content column for the dashboard.
templ dashboardContent(view DashboardView) {
	<div class="mx-dash-page" hx-history="false">
		<div class="mx-dash-header">
			<h1 class="mx-dash-title">Dashboard</h1>
			<p class="mx-dash-sub">
				Read-only. Queue and outcome data are from the database at render time; refresh the page to update.
				if view.AsOf != "" {
					<span class="mx-dash-asof"> As of { view.AsOf }.</span>
				}
			</p>
		</div>
		@dashQueueTiles(view.QueueTiles, view.QueueChart)
		@dashResultsTiles(view.ResultsTiles)
		@dashProviderTiles(view.ProviderTiles)
		@dashUpNext(view.InFlightRows, view.UpNextRows, view.UpNextHeader, view.UpNextEmpty)
		@dashRecentOutcomes(view.RecentRows)
		@dashNeedsAttention(view.AttentionRows, view.AttentionLimit)
		<p class="mx-dash-maintenance-note" title="Stacked (multi-timestamp) .lrc sidecars render incorrectly in simple players; reconcile-lrc expands them to one cue per line.">
			{ view.LRCNormalizeSummary }
			<a class="mx-dash-maintenance-link" href="https://sydlexius.github.io/canticle/lrc-normalization/" target="_blank" rel="noopener noreferrer" aria-label="About LRC normalization (opens in a new tab)">What is this?</a>
		</p>
		<p class="mx-dash-metrics-note">
			Prometheus metrics:
			<code class="mx-dash-code">/metrics</code>
			<span
				title="Loopback by default; trusted-network gated. No API key required."
				class="mx-dash-metrics-hint"
			>(trusted network)</span>
		</p>
	</div>
	<script>
	(function() {
		// Reformat the title of <time data-tz="pending"> elements to the browser's local timezone.
		// Skipped when data-tz-applied="1" (server already applied TZ env).
		// Uses 'en-US' locale so timeZoneName:'short' always emits a 3-letter
		// abbreviation (e.g. "PDT") rather than a "GMT-7" offset, regardless
		// of the browser's default locale.
		document.querySelectorAll('time[data-tz="pending"]').forEach(function(el) {
			var iso = el.getAttribute('datetime');
			if (!iso) return;
			try {
				var d = new Date(iso);
				var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
				// The visible text is the server's relative label; only the
				// exact-time tooltip is localized.
				el.title = d.toLocaleString('en-US', {
					year: 'numeric', month: '2-digit', day: '2-digit',
					hour: '2-digit', minute: '2-digit',
					timeZone: tz,
					timeZoneName: 'short'
				});
			} catch (_) {}
		});
	})();
	</script>
	// Vendored Chart.js (UMD, v4.4.9) + the dashboard chart init, both served
	// from /static under the serve-mode CSP's script-src 'self' (no CDN, no
	// chart code embedded in the page). defer keeps them non-render-blocking and preserves
	// document order, so chart-init.js runs after Chart is defined and the
	// canvases are parsed. Charts complement the tiles; if either script is
	// blocked the tiles and table still render (see the noscript in dashChart).
	<script src="/static/js/chart.umd.min.js" defer></script>
	<script src="/static/js/chart-init.js" defer></script>
}

// dashQueueTiles renders the work-queue status tile row: statuses only (#599).
// What a completed track ended up with is the Results row.
// The status-distribution doughnut (#318) is rendered after the tiles as a
// complementary visual; it is omitted when every queue count is zero.
templ dashQueueTiles(tiles []StatTile, chart ChartData) {
	<section
		class="mx-dash-section"
		aria-labelledby="mx-dash-queue-heading"
		title="Track counts by queue status. Values update on page refresh; processing is asynchronous."
	>
		<h2 class="mx-dash-section-title" id="mx-dash-queue-heading">Work Queue</h2>
		<div class="mx-dash-tiles" role="list">
			if len(tiles) == 0 {
				<p class="mx-dash-empty">No queue data available.</p>
			}
			for _, t := range tiles {
				<div class="mx-dash-tile" role="listitem" title={ t.Tooltip }>
					if t.Href != "" {
						<a class="mx-dash-tile-link" href={ templ.SafeURL(t.Href) } title={ t.Tooltip }>
							<span class="mx-dash-tile-label">{ t.Label }</span>
							<span class="mx-dash-tile-value">{ t.Value }</span>
						</a>
					} else {
						<span class="mx-dash-tile-label">{ t.Label }</span>
						<span class="mx-dash-tile-value">{ t.Value }</span>
					}
				</div>
			}
		</div>
		if chart.HasData() {
			@dashChart("mx-dash-queue-chart", "doughnut", "Work queue status distribution", "", chart)
		}
	</section>
}

// dashResultsTiles renders the Results tile row (#599): completed tracks split
// by result type. It is its OWN section, not folded into dashQueueTiles: it
// classifies the Finished + Settled (upgradable) population by outcome, a
// different axis than queue status, and its tiles sum to that pair. Tooltips
// come from the resultBuckets definition.
templ dashResultsTiles(tiles []StatTile) {
	<section
		class="mx-dash-section"
		aria-labelledby="mx-dash-results-heading"
		title="What each completed track ended up with. Adds up to Finished plus Settled (upgradable) in the Work Queue."
	>
		<h2 class="mx-dash-section-title" id="mx-dash-results-heading">Results</h2>
		<div class="mx-dash-tiles" role="list">
			for _, t := range tiles {
				<div class="mx-dash-tile" role="listitem" title={ t.Tooltip }>
					<span class="mx-dash-tile-label">{ t.Label }</span>
					<span class="mx-dash-tile-value">{ t.Value }</span>
				</div>
			}
		</div>
	</section>
}

// dashProviderTiles renders the per-lyrics-source tile row. Each tile carries
// its hit rate as an inline mini bar (#318) under the rate value, so the bar
// aligns with its bubble by construction. The bar replaced a separate standalone
// hit-rate bar chart. The fill width is applied by chart-init.js from the
// data-hit-rate attribute -- the serve-mode CSP (style-src 'self', no
// unsafe-inline) forbids an inline style="" width.
templ dashProviderTiles(tiles []StatTile) {
	<section
		class="mx-dash-section"
		aria-labelledby="mx-dash-provider-heading"
		title="Hit count and rate per lyrics source as tracks are processed."
	>
		<h2 class="mx-dash-section-title" id="mx-dash-provider-heading">Lyrics Sources</h2>
		<div class="mx-dash-tiles" role="list">
			if len(tiles) == 0 {
				<p class="mx-dash-empty">No lyrics source data yet. Data accrues as tracks are processed.</p>
			}
			for _, t := range tiles {
				<div class="mx-dash-tile" role="listitem">
					<span class="mx-dash-tile-label">@laneCell(t.Label, t.LabelMark)</span>
					<span class="mx-dash-tile-value">{ t.Value }</span>
					if t.Sub != "" {
						<span class="mx-dash-tile-sub">{ t.Sub }</span>
					}
					@dashTileHitBar(t)
					if t.Status != "" {
						<span class={ "mx-dash-tile-status mx-dash-tile-status-" + t.Status }>{ t.StatusText }</span>
					}
				</div>
			}
		</div>
	</section>
}

// dashTileHitBar renders the inline mini hit-rate bar for a provider/cache tile
// (#318), shown only when the tile carries a hit rate (ShowBar). The track is a
// thin rail; the fill's width is set client-side by chart-init.js from the
// data-hit-rate integer percent (CSP-safe -- no inline style width). The title
// gives the percent so the bar is not purely visual.
templ dashTileHitBar(t StatTile) {
	if t.ShowBar {
		<div class="mx-dash-tile-bar" role="img" title={ t.BarLabel } aria-label={ t.BarLabel }>
			<div class="mx-dash-tile-bar-fill" data-hit-rate={ t.BarPct }></div>
		</div>
	}
}

// dashChart renders one Chart.js canvas inside a sized wrapper. The series is
// serialized into data-* attributes; the vendored, CSP-safe chart-init.js reads
// them and draws the chart (colors are resolved client-side from design tokens).
// kind is "doughnut" or "bar"; suffix (e.g. "%") annotates bar values. A
// noscript fallback notes that the tiles above carry the same data, so the chart
// is purely complementary -- nothing is lost when scripts are disabled.
templ dashChart(canvasID, kind, ariaLabel, suffix string, chart ChartData) {
	<div class="mx-dash-chart-wrap">
		<canvas
			id={ canvasID }
			class="mx-dash-chart"
			role="img"
			aria-label={ ariaLabel }
			data-chart-type={ kind }
			data-chart-suffix={ suffix }
			data-chart-labels={ chart.LabelsJSON() }
			data-chart-values={ chart.ValuesJSON() }
		></canvas>
		<noscript>
			<p class="mx-dash-empty">Chart requires JavaScript; the same data is shown in the tiles above.</p>
		</noscript>
	</div>
}

// dashRecentOutcomes renders the recent-outcomes table (up to 20 rows).
templ dashRecentOutcomes(rows []RecentOutcomeRow) {
	<section
		class="mx-dash-section"
		aria-labelledby="mx-dash-outcomes-heading"
		title="Up to 20 most recently completed tracks. A newly submitted track appears here after the background worker processes it."
	>
		<h2 class="mx-dash-section-title" id="mx-dash-outcomes-heading">Recent Outcomes</h2>
		<p class="mx-dash-section-sub">Completion is asynchronous -- a newly submitted track may not appear until the worker processes it.</p>
		if len(rows) == 0 {
			<div class="mx-report-empty">
				<span>No completed tracks yet. Tracks complete asynchronously in the background.</span>
			</div>
		} else {
			<div class="mx-table-wrap">
				<table class="mx-table" aria-label="Recent track outcomes">
					<thead>
						<tr>
							<th>Artist</th>
							<th>Album</th>
							<th>Title</th>
							<th>Result</th>
							<th>Source</th>
							<th>Completed</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr>
								<td>{ row.Artist }</td>
								<td>{ AlbumText(row.Album) }</td>
								<td>{ row.Title }</td>
								<td>
									if row.ResultTierClass != "" {
										<span class={ row.ResultTierClass } if row.Detail != "" { title={ row.Detail } } if row.ResultAria != "" { role="img" aria-label={ row.ResultAria } }>{ row.Result }</span>
									} else {
										{ row.Result }
									}
								</td>
								<td>@laneCell(row.Lane, row.LaneMark)</td>
								<td class="mx-table-mono">
									if row.CompletedAtISO != "" && row.CompletedAtRelative != "" {
										if row.CompletedAtTZApplied {
											<time datetime={ row.CompletedAtISO } title={ row.CompletedAt } data-tz-applied="1">{ row.CompletedAtRelative }</time>
										} else {
											<time datetime={ row.CompletedAtISO } title={ row.CompletedAt } data-tz="pending">{ row.CompletedAtRelative }</time>
										}
									} else {
										{ row.CompletedAt }
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// dashNeedsAttention renders failed then deferred rows (#654 AC2), apart from
// Recent Outcomes so its Result column holds lyric classifications only.
templ dashNeedsAttention(rows []AttentionRow, limit int) {
	<section
		class="mx-dash-section"
		aria-labelledby="mx-dash-attention-heading"
		title={ attentionTooltip(limit) }
	>
		<h2 class="mx-dash-section-title" id="mx-dash-attention-heading">Needs Attention</h2>
		<p class="mx-dash-section-sub">Failed and deferred tracks have no lyric outcome yet. Failed rows come first.</p>
		@attentionTable(rows, "Nothing failed or deferred.")
	</section>
}

// attentionTable is the Needs attention table, shared by the dashboard section
// and the Reports view so the two cannot drift.
templ attentionTable(rows []AttentionRow, emptyMsg string) {
	if len(rows) == 0 {
		<div class="mx-report-empty"><span>{ emptyMsg }</span></div>
	} else {
		<div class="mx-table-wrap">
			<table class="mx-table" aria-label="Failed and deferred tracks">
				<thead>
					<tr>
						<th scope="col">Artist</th>
						<th scope="col">Album</th>
						<th scope="col">Title</th>
						<th scope="col">State</th>
						<th scope="col">Reason</th>
						<th scope="col">Last attempt</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td>{ r.Artist }</td>
							<td>{ AlbumText(r.Album) }</td>
							<td>{ r.Title }</td>
							<td><span class={ r.StateClass }>{ r.State }</span></td>
							<td class="mx-attention-reason">{ r.Reason }</td>
							<td class="mx-table-mono">{ r.LastAttempt }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// dashUpNext renders the "Up next" panel (#572): the buffered work the worker
// will claim next, in claim order. When the lookahead buffer is empty (an idle
// queue, or batching disabled via queue.batch_size = 0) it shows the eligible/
// cooldown counts only, with no ordered list and no ordering claim -- the empty
// value carries that pre-formatted line. Reuses the mx-table styling from
// dashRecentOutcomes so the two tables read as one system.
templ dashUpNext(inFlight []InFlightRow, rows []UpNextRow, header, empty string) {
	<section
		class="mx-dash-section"
		aria-labelledby="mx-dash-upnext-heading"
		title={ dashUpNextTitle(len(rows)+len(inFlight) == 0, len(inFlight) > 0) }
	>
		<h2 class="mx-dash-section-title" id="mx-dash-upnext-heading">Up Next</h2>
		if len(rows)+len(inFlight) == 0 {
			<p class="mx-dash-empty">{ empty }</p>
		} else {
			<p class="mx-dash-section-sub">{ header }</p>
			<div class="mx-table-wrap">
				<table class="mx-table" aria-label={ dashUpNextTableLabel(len(inFlight) > 0) }>
					<thead>
						<tr>
							<th class="mx-upnext-pos">#</th>
							<th>Artist</th>
							<th>Album</th>
							<th>Title</th>
							<th>Tier</th>
							<th class="mx-upnext-waited">Waited</th>
						</tr>
					</thead>
					<tbody>
						for _, f := range inFlight {
							<tr class="mx-upnext-inflight">
								<td class="mx-cell-mono mx-upnext-pos">-</td>
								<td>{ f.Artist }</td>
								<td>{ AlbumText(f.Album) }</td>
								<td>{ f.Title }</td>
								<td>
									<span class="mx-upnext-tier mx-upnext-tier-inflight">in flight</span>
									if f.Stuck {
										<span class="mx-upnext-tier mx-upnext-tier-stuck" title="Claimed longer ago than any single item should take. A crashed run can leave a row like this until restart.">stuck?</span>
									}
								</td>
								<td class="mx-cell-mono mx-upnext-waited" title="Time since the worker claimed this row">{ f.Elapsed }</td>
							</tr>
						}
						for _, row := range rows {
							<tr>
								<td class="mx-cell-mono mx-upnext-pos">{ row.Position }</td>
								<td>{ row.Artist }</td>
								<td>{ AlbumText(row.Album) }</td>
								<td>{ row.Title }</td>
								<td><span class={ dashUpNextTierClass(row.Tier) }>{ row.Tier }</span></td>
								<td class="mx-cell-mono mx-upnext-waited">{ row.Waited }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// dashUpNextTitle returns the section tooltip. Only the populated panel asserts
// claim ORDER; the empty state has no ordered list, so it must not imply one
// (#572 CR). When rows are already claimed (#599) the table opens with them, so
// the text names both groups rather than calling everything upcoming.
func dashUpNextTitle(empty, inFlight bool) string {
	if empty {
		return "Buffered upcoming work. Nothing is buffered right now; showing the eligible and cooldown counts. Refresh to update."
	}
	if inFlight {
		return "Rows the background worker is processing now, then buffered upcoming work in the order it will claim it. Composed once per batch; refresh to update."
	}
	return "Buffered upcoming work in the order the background worker will claim it. Composed once per batch; refresh to update."
}

// dashUpNextTableLabel names the Up Next table for assistive tech, matching
// dashUpNextTitle: in-flight rows are current work, not upcoming work (#599).
func dashUpNextTableLabel(inFlight bool) string {
	if inFlight {
		return "Queue work in progress and upcoming"
	}
	return "Upcoming queue work"
}

// dashUpNextTierClass returns the badge classes for an Up-next tier label. The
// miss tier (deferred benign-miss backlog) gets a muted amber variant and the
// upgrade tier (upgrade-sweep trips, #1151) a neutral one, so both read as
// distinct from fresh scan/webhook work at a glance.
func dashUpNextTierClass(tier string) string {
	switch tier {
	case "miss":
		return "mx-upnext-tier mx-upnext-tier-miss"
	case "upgrade":
		return "mx-upnext-tier mx-upnext-tier-upgrade"
	}
	return "mx-upnext-tier mx-upnext-tier-fresh"
}

// iconDashboard is the grid glyph for the Dashboard sidebar nav item.
templ iconDashboard() {
	<svg class="mx-nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="3" y="3" width="7" height="7"></rect>
		<rect x="14" y="3" width="7" height="7"></rect>
		<rect x="14" y="14" width="7" height="7"></rect>
		<rect x="3" y="14" width="7" height="7"></rect>
	</svg>
}
