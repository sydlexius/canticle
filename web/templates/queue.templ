package templates

// QueuePage is the full /queue/{bucket} drill-down page (#598): the rows behind
// one dashboard queue counter, in id order, with a keyset "Show more". It ships
// its own small stylesheet through Layout's pageCSS slot so the shared CSS is
// untouched.
templ QueuePage(version string, view QueueView, reports []RailItem, musixmatchInactive bool, musixmatchServing bool) {
	@Layout(view.Title+" queue", "/queue", version, reports, "/static/css/queue.css", musixmatchInactive, musixmatchServing) {
		// queue.js restores focus after a "Show more" swap replaces its own row.
		<script src="/static/js/queue.js" defer></script>
		<h1 class="mx-page-title">{ view.Title }</h1>
		<p class="mx-page-subtitle">{ view.Blurb }</p>
		<p class="mx-queue-nav">
			<a class="mx-queue-link" href="/dashboard">Back to dashboard</a>
			if view.After > 0 {
				<a class="mx-queue-link" href={ templ.SafeURL(view.StartHref) }>Back to start of list</a>
			}
			if view.ReviveLink {
				<a class="mx-queue-link" href="/queue/unavailable/revive">Revive retired tracks</a>
			}
		</p>
		<form class="mx-queue-search" method="get" action={ templ.SafeURL("/queue/" + view.Key) } role="search">
			<label class="mx-queue-search-label" for="mx-queue-q">Search artist or title</label>
			<input class="mx-queue-search-input" id="mx-queue-q" type="search" name="q" value={ view.Query } autocomplete="off"/>
			if view.Sort != "" {
				<input type="hidden" name="sort" value={ view.Sort }/>
			}
			if view.Dir != "" {
				<input type="hidden" name="dir" value={ view.Dir }/>
			}
			for _, h := range view.Hidden {
				<input type="hidden" name={ h.Name } value={ h.Value }/>
			}
			if len(view.Libraries) > 0 {
				<span class="mx-queue-field">
					<label class="mx-queue-search-label" for="mx-queue-library">Library</label>
					<select class="mx-queue-filter" id="mx-queue-library" name="library" autocomplete="off" data-queue-autosubmit>
						<option value="">All libraries</option>
						for _, o := range view.Libraries {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</span>
			}
			if len(view.Lanes) > 0 {
				<span class="mx-queue-field">
					<label class="mx-queue-search-label" for="mx-queue-lane">Source</label>
					<select class="mx-queue-filter" id="mx-queue-lane" name="lane" autocomplete="off" data-queue-autosubmit>
						<option value="">All sources</option>
						for _, o := range view.Lanes {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</span>
			}
			if len(view.Reasons) > 0 {
				<span class="mx-queue-field">
					<label class="mx-queue-search-label" for="mx-queue-reason">Reason</label>
					<select class="mx-queue-filter" id="mx-queue-reason" name="reason" autocomplete="off" data-queue-autosubmit>
						<option value="">All reasons</option>
						for _, o := range view.Reasons {
							<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
						}
					</select>
				</span>
			}
			<button class="mx-run-button" type="submit">Search</button>
			if view.Query != "" {
				<a class="mx-queue-link" href={ templ.SafeURL(view.ClearHref) }>Clear search</a>
			}
		</form>
		if len(view.Chips) > 0 {
			<nav class="mx-queue-chips" aria-label="Filter rows">
				for _, c := range view.Chips {
					<a
						class={ "mx-queue-chip", templ.KV("is-active", c.Active) }
						href={ templ.SafeURL(c.Href) }
						if c.Active {
							aria-current="true"
						}
					>{ c.Label }</a>
				}
			</nav>
		}
		if len(view.Rows) == 0 {
			if view.After > 0 {
				<p class="mx-dash-empty">No more rows.</p>
			} else if view.Filtered && view.Query != "" {
				<p class="mx-dash-empty">No tracks match your search and the selected filters. <a class="mx-queue-link" href={ templ.SafeURL(view.ClearHref) }>Clear the search</a> to see every track matching the filters.</p>
			} else if view.Filtered {
				<p class="mx-dash-empty">No tracks match the selected filters.</p>
			} else if view.Query != "" {
				<p class="mx-dash-empty">No tracks match your search. <a class="mx-queue-link" href={ templ.SafeURL(view.ClearHref) }>Clear the search</a> to see every track in this bucket.</p>
			} else {
				<p class="mx-dash-empty">No rows in this bucket.</p>
			}
		} else {
			<div class="mx-table-wrap mx-queue-wrap">
				<table class="mx-table" aria-label={ view.Title + " rows" }>
					<thead>
						<tr>
							for _, col := range view.Columns {
								@SortHeader(col)
							}
						</tr>
					</thead>
					<tbody id="mx-queue-body">
						@QueueRows(view)
					</tbody>
				</table>
			</div>
		}
	}
}

// QueueRows is the htmx "Show more" fragment and the tbody content of the full
// page: the page's rows, then (when more remain) a final row holding the Show
// more control. The control targets its own row with an outerHTML swap, so the
// response replaces it with the next rows and, if any remain, a fresh control;
// no out-of-band swap is needed. The href mirrors hx-get so it degrades to a
// plain navigation without JS.
templ QueueRows(view QueueView) {
	for i, row := range view.Rows {
		// The first row of each batch is the focus target for queue.js.
		<tr
			if i == 0 {
				data-queue-batch="first"
			}
		>
			<td>{ row.Artist }</td>
			<td>{ AlbumText(row.Album) }</td>
			<td>{ row.Title }</td>
			<td>{ row.Status }</td>
			<td>{ row.Reason }</td>
			<td class="mx-cell-mono">{ row.NextAttemptAt }</td>
			<td class="mx-cell-mono">{ row.MissCount }</td>
			<td class="mx-cell-mono">{ row.Attempts }</td>
			<td class="mx-cell-mono">{ row.UpdatedAt }</td>
			<td>{ row.Libraries }</td>
			<td>
				if row.PreviewHref != "" {
					<a class="mx-queue-link mx-queue-preview" href={ templ.SafeURL(row.PreviewHref) }>{ row.PreviewLabel }</a>
				}
				if row.Edited {
					<span class="mx-result-tier mx-result-tier-unknown mx-queue-edited" title={ row.EditedTitle }>Edited { row.EditedTitle }</span>
				}
			</td>
		</tr>
	}
	if view.NextCursor > 0 {
		<tr class="mx-queue-more-row">
			<td colspan="11">
				<a
					class="mx-run-button mx-queue-more"
					href={ templ.SafeURL(view.MoreHref) }
					hx-get={ view.MoreHref }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					Show more
				</a>
			</td>
		</tr>
	}
}
