package templates

// QueueIndexPage is the /queue landing page (#1241): one row per work-queue
// bucket with its count and a link to the drill-down. The rows are the
// dashboard's own queue tiles (same labels, counts, order and hrefs), so the
// two surfaces cannot disagree. Finished and Settled rows add a hint that
// their synced tracks can be previewed and have their timing edited, since
// that is the only route to the player.
templ QueueIndexPage(version string, tiles []StatTile, reports []RailItem, musixmatchInactive bool, musixmatchServing bool) {
	@Layout("Queue", "/queue", version, reports, "/static/css/queue-index.css", musixmatchInactive, musixmatchServing) {
		<h1 class="mx-page-title">Queue</h1>
		<p class="mx-page-subtitle">Every track canticle is working on, by where it stands. Pick a bucket to see its tracks.</p>
		<div class="mx-table-wrap">
			<table class="mx-table" aria-label="Queue buckets">
				<thead>
					<tr>
						<th>Bucket</th>
						<th>Tracks</th>
						<th>About</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tiles {
						<tr class="mx-queue-index-row">
							<td><a class="mx-queue-link" href={ templ.SafeURL(t.Href) }>{ t.Label }</a></td>
							<td class="mx-cell-mono">{ t.Value }</td>
							<td>
								{ t.Tooltip }
								if queueIndexEditable(t.Href) {
									<span class="mx-queue-index-hint">Synced tracks here can be previewed and their timing edited.</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// queueIndexEditable reports whether a bucket's rows can carry a Preview link:
// the two completed buckets, Finished and Settled.
func queueIndexEditable(href string) bool {
	return href == "/queue/finished" || href == "/queue/settled"
}
