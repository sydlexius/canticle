package templates

// QueueIndexPage is the /queue landing page (#1241): one row per work-queue
// bucket with its count and a link to the drill-down. The rows are the
// dashboard's own queue tiles (same labels, counts, order and hrefs), so the
// two surfaces cannot disagree. Finished and Settled rows add a hint about the
// player, since those buckets are the only route to it (see queueIndexHint for
// which bucket holds the editable line-synced tracks under each word sync mode).
templ QueueIndexPage(version string, tiles []StatTile, reports []RailItem, musixmatchInactive bool, musixmatchServing bool, lineTop bool) {
	@Layout("Queue", "/queue", version, reports, "/static/css/queue-index.css", musixmatchInactive, musixmatchServing) {
		<h1 class="mx-page-title">Queue</h1>
		<p class="mx-page-subtitle">Every track canticle is working on, by where it stands. Pick a bucket to see its tracks.</p>
		<div class="mx-table-wrap">
			<table class="mx-table" aria-label="Queue buckets">
				<thead>
					<tr>
						<th>Bucket</th>
						<th>Tracks</th>
						<th>About</th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tiles {
						<tr class="mx-queue-index-row">
							<td><a class="mx-text-link" href={ templ.SafeURL(t.Href) }>{ t.Label }</a></td>
							<td class="mx-cell-mono">{ t.Value }</td>
							<td>
								{ t.Tooltip }
								if hint := queueIndexHint(t.Href, lineTop); hint != "" {
									<span class="mx-queue-index-hint">{ hint }</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// queueIndexHint is the player hint for a bucket row, or "" for a bucket with
// no Preview links. Finished rows are word-tier, which the preview page opens
// read-only (fillPreviewEditor); Settled rows can hold line-synced tracks,
// which get the offset editor. With word sync off (lineTop, #1275) the
// line-synced tracks are Finished, so the editor hint moves with them and
// Settled holds no previewable track.
func queueIndexHint(href string, lineTop bool) string {
	switch {
	case href == "/queue/finished" && lineTop:
		return "Synced tracks here can be previewed; line-synced ones can also have their timing edited."
	case href == "/queue/finished":
		return "Synced tracks here can be previewed (read-only: they have word timing)."
	case href == "/queue/settled" && !lineTop:
		return "Line-synced tracks here can be previewed and their timing edited."
	}
	return ""
}
