#!/usr/bin/env bash
#
# pre-commit hook: catches common issues locally before push.
#
# Checks (in order, fast-fail):
#   1. typos -- spell check staged files (uses .typos.toml config)
#   2. gofmt -- staged .go files are correctly formatted
#   3. go build -- code compiles
#   4. golangci-lint -- full linter suite from .golangci.yml
#   5. govulncheck -- known vulnerabilities in dependencies
#
# Skip with: git commit --no-verify (use sparingly)

set -euo pipefail

# Colors (disabled if not a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BOLD='\033[1m'
    RESET='\033[0m'
else
    RED='' GREEN='' YELLOW='' BOLD='' RESET=''
fi

fail() {
    echo -e "${RED}${BOLD}FAIL${RESET} $1" >&2
    exit 1
}

pass() {
    echo -e "${GREEN}PASS${RESET} $1"
}

warn() {
    echo -e "${YELLOW}SKIP${RESET} $1"
}

# --------------------------------------------------------------------------
# 0. conflict markers -- reject unresolved merge markers in staged content
# --------------------------------------------------------------------------
# git diff --check flags leftover conflict markers (and whitespace errors); we
# grep for just the conflict-marker lines so whitespace nits are left to the
# dedicated hooks. git's own detector avoids markdown setext false positives.
CONFLICT_HITS=$(git diff --cached --check 2>/dev/null | grep -i 'conflict marker' || true)
if [ -n "$CONFLICT_HITS" ]; then
    echo -e "${RED}${BOLD}FAIL${RESET} conflict markers:"
    echo "$CONFLICT_HITS"
    exit 1
fi
pass "conflict markers"

# --------------------------------------------------------------------------
# 1. typos -- spell check staged files
# --------------------------------------------------------------------------
if git diff --cached --name-only --diff-filter=ACM -- | grep -q .; then
    if ! command -v typos &>/dev/null; then
        warn "typos (not installed, skipping)"
    else
        TYPOS_FILES=$(git diff --cached --name-only -z --diff-filter=ACM -- | tr '\0' '\n')
        if ! TYPOS_OUTPUT=$(printf '%s\n' "$TYPOS_FILES" | tr '\n' '\0' | xargs -0 typos --force-exclude -- 2>&1); then
            echo -e "${RED}${BOLD}FAIL${RESET} typos:"
            echo "$TYPOS_OUTPUT"
            exit 1
        fi
        pass "typos"
    fi
else
    warn "typos (no staged files)"
fi

# --------------------------------------------------------------------------
# 1b. product name -- the logotype is "Canticle" in user-facing prose
# --------------------------------------------------------------------------
# Scoped to STAGED markdown so the check costs nothing on a code-only commit.
# Lowercase stays correct in identifiers (module path, image ref, binary, URLs);
# the helper masks those spans, so anything it reports is genuine prose. This is
# deliberately not a typos rule -- typos has no context and would flag every
# ghcr.io/sydlexius/canticle in the tree.
#
# An ARRAY, not a space-separated string: a path containing a space would
# word-split into two bogus arguments, and quoting the string would pass every
# path as ONE argument. The array is correct under both.
#
# --staged tells the helper to read each path's STAGED blob via `git show
# :<path>`, never the worktree file. Without it, a commit could sail through
# on lowercase prose that was staged and then "fixed" in the worktree without
# `git add -p` re-staging the fix -- the hook would report PASS while the
# actual commit content stays wrong, because a plain open() reads whatever is
# sitting on disk right now, not what `git commit` is about to record.
PRODNAME_FILES=()
while IFS= read -r -d '' f; do
    PRODNAME_FILES+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACM -- 'README.md' 'docs/*.md')
if [ ${#PRODNAME_FILES[@]} -gt 0 ]; then
    if [ ! -x scripts/check-product-name.sh ]; then
        warn "product name (helper missing, skipping)"
    elif ! PRODNAME_OUTPUT=$(bash scripts/check-product-name.sh --staged "${PRODNAME_FILES[@]}" 2>&1); then
        echo -e "${RED}${BOLD}FAIL${RESET} product name:"
        echo "$PRODNAME_OUTPUT"
        exit 1
    else
        pass "product name"
    fi
else
    warn "product name (no staged docs)"
fi

# --------------------------------------------------------------------------
# 2. gofmt -- check staged .go files
# --------------------------------------------------------------------------
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)
if [ -n "$STAGED_GO" ]; then
    UNFORMATTED=$(echo "$STAGED_GO" | xargs gofmt -l -- 2>/dev/null || true)
    if [ -n "$UNFORMATTED" ]; then
        echo -e "${RED}${BOLD}FAIL${RESET} gofmt: the following files need formatting:"
        echo "$UNFORMATTED" | sed 's/^/  /'
        echo ""
        echo "Run: gofmt -w . && git add -p"
        exit 1
    fi
    pass "gofmt"
else
    warn "gofmt (no staged .go files)"
fi

# --------------------------------------------------------------------------
# 3. go build -- make sure everything compiles
# --------------------------------------------------------------------------
STAGED_GO_ANY=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' 'go.mod' 'go.sum' || true)
if [ -n "$STAGED_GO_ANY" ]; then
    BUILD_LOG=$(mktemp "${TMPDIR:-/tmp}/pre-commit-build.XXXXXX")
    if ! go build ./... 2>"$BUILD_LOG"; then
        echo -e "${RED}${BOLD}FAIL${RESET} go build:"
        head -30 "$BUILD_LOG"
        rm -f "$BUILD_LOG"
        exit 1
    fi
    rm -f "$BUILD_LOG"
    pass "go build"
else
    warn "go build (no staged .go / go.mod / go.sum files)"
fi

# --------------------------------------------------------------------------
# 4. golangci-lint -- full linter suite (matches CI exactly)
# --------------------------------------------------------------------------
if [ -n "$STAGED_GO_ANY" ]; then
    if ! command -v golangci-lint &>/dev/null; then
        warn "golangci-lint (not installed, skipping)"
    else
        if ! LINT_OUTPUT=$(golangci-lint run ./... 2>&1); then
            echo -e "${RED}${BOLD}FAIL${RESET} golangci-lint:"
            echo "$LINT_OUTPUT"
            exit 1
        fi
        pass "golangci-lint"
    fi
else
    warn "golangci-lint (no staged .go / go.mod / go.sum files)"
fi

# --------------------------------------------------------------------------
# 5. govulncheck -- check for known vulnerabilities in dependencies
# --------------------------------------------------------------------------
if [ -n "$STAGED_GO_ANY" ]; then
    if ! command -v govulncheck &>/dev/null; then
        warn "govulncheck (not installed, skipping)"
    else
        if ! VULN_OUTPUT=$(govulncheck ./... 2>&1); then
            echo -e "${RED}${BOLD}FAIL${RESET} govulncheck:"
            echo "$VULN_OUTPUT"
            exit 1
        fi
        pass "govulncheck"
    fi
else
    warn "govulncheck (no staged .go / go.mod / go.sum files)"
fi

echo ""
echo -e "${GREEN}${BOLD}All pre-commit checks passed.${RESET}"
